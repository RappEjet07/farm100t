#!/usr/bin/env python3

"""

Playwright helper: loads 100t.xiaomimimo.com, fills form, clicks submit

to trigger Xiaomi SDK captcha check. Intercepts /captcha/v2/data response

and extracts the encrypted 'e' token from the challenge URL.

Outputs: event_id\te_token (tab-separated) on success.

"""

import sys

import json

from urllib.parse import urlparse, parse_qs

from playwright.sync_api import sync_playwright

 
TARGET_URL = "https://100t.xiaomimimo.com/"

CAPTCHA_DATA_URL = "https://verify.sec.xiaomi.com/captcha/v2/data"

 
 
def main():

    with sync_playwright() as p:

        browser = p.chromium.launch(headless=True)

        context = browser.new_context(

            user_agent="Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 "

                       "(KHTML, like Gecko) Chrome/148.0.0.0 Safari/537.36",

            viewport={"width": 1920, "height": 1080},

        )

        page = context.new_page()

 
        result = {"event_id": None, "e_token": None, "found": False}

 
        def handle_response(response):

            if CAPTCHA_DATA_URL in response.url and not result["found"]:

                try:

                    body = response.json()

                    if body.get("code") == 0:

                        data = body.get("data", {})

                        result["event_id"] = data.get("id", "")

                        challenge_url = data.get("url", "")

                        if challenge_url:

                            parsed = urlparse(challenge_url)

                            qs = parse_qs(parsed.query)

                            result["e_token"] = qs.get("e", [""])[0]

                        result["found"] = True

                except:

                    pass

 
        page.on("response", handle_response)

 
        # Load page

        try:

            page.goto(TARGET_URL, wait_until="domcontentloaded", timeout=30000)

            page.wait_for_timeout(3000)

        except Exception as e:

            print(f"Page load error: {e}", file=sys.stderr)

 
        # Click Apply Now to show form

        try:

            page.click('button:has-text("立即申请")', timeout=5000)

            page.wait_for_timeout(1000)

        except Exception as e:

            print(f"Apply click error: {e}", file=sys.stderr)

 
        # Fill form with minimal valid data

        try:

            page.fill('input[type="email"]', f'test_{int(__import__("time").time())}@mahiru.my.id')

            page.fill('textarea', 'AI-driven automation workflow using Claude Code.')

            page.fill('input[type="url"]', 'https://github.com/test/repo')

            page.click('button:has-text("Claude Code")', timeout=3000)

            page.wait_for_timeout(300)

            page.click('button:has-text("Claude 系列")', timeout=3000)

            page.wait_for_timeout(300)

        except Exception as e:

            print(f"Form fill error: {e}", file=sys.stderr)

 
        # Click Submit to trigger captcha

        try:

            page.click('button:has-text("提交")', timeout=5000)

            # Wait for captcha data check to fire

            page.wait_for_timeout(8000)

        except Exception as e:

            print(f"Submit click error: {e}", file=sys.stderr)

 
        browser.close()

 
        if result["found"] and result["event_id"] and result["e_token"]:

            print(f"{result['event_id']}\t{result['e_token']}")

            sys.exit(0)

        else:

            print("FAIL", file=sys.stderr)

            sys.exit(1)

 
 
if __name__ == "__main__":

    main()
